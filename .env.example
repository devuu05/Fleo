# --- Data source ---------------------------------------------------------
# Leave TRAVELPAYOUTS_TOKEN empty to run in SAMPLE_DATA mode (generated fares). With a token, real mode uses its own DB.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Force sample mode on/off regardless of token (1/0). Default: on when no token.
# SAMPLE_DATA=1
# Business-class queries stay off for the real API until you've verified that the
# v3 prices_for_dates endpoint honours trip_class (see README). Set to 1 to enable.
# TP_BUSINESS_ENABLED=0
# COLLECTOR_RPS=3

# --- Database --------------------------------------------------------------
# Empty = embedded PGlite in .data/pglite (local dev). Set to your Supabase/Postgres URL in prod.
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# --- Detection / filters / gating (defaults shown) ---------------------------
# DEAL_MIN_PCT_BELOW=40
# DEAL_MIN_SAVINGS_INR=5000
# ERROR_FARE_PCT_BELOW=70
# BASELINE_DAYS=30
# BASELINE_MIN_SNAPSHOTS=10
# BASELINE_MIN_SPAN_DAYS=5
# DETECT_LOOKBACK_HOURS=6
# MAX_STOPS=1
# MAX_DURATION_HOURS=30
# FREE_DELAY_HOURS=24
# FREE_ONE_IN_N=10

# --- Ops ---------------------------------------------------------------------
# Bearer secret for GET /api/cron/collect
CRON_SECRET=

# --- Auth (Supabase) -----------------------------------------------------------
# Set both to use real Supabase Auth (email magic link). Unset = local dev login (non-production only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin used in magic links; defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=https://fleo.example

# --- Admin review ----------------------------------------------------------------
# 1 = new deals wait in /admin until approved. 0 = publish immediately.
# REVIEW_REQUIRED=0
# Comma-separated admin emails. Unset = any dev-login user is admin (never in production).
ADMIN_EMAILS=

# --- Payments (Razorpay) ---------------------------------------------------------
# Unset = test checkout (no money moves, non-production only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PLAN_PRICE_INR=1499

# --- Alerts (email via Resend) -----------------------------------------------------
# Unset = alerts are written to the in-app outbox (/alerts) but not emailed.
RESEND_API_KEY=
ALERT_FROM=Fleo <alerts@yourdomain.com>

# --- Limit a real-data run while testing (comma-separated codes) ---------------------
# COLLECT_ORIGINS=DEL,BOM
# COLLECT_DESTINATIONS=BKK,DXB,SIN,LHR
